# ==============================
# فایل تنظیمات - این فایل را کپی کنید به .env و مقادیر را پر کنید
# هرگز فایل .env را در گیت هاب آپلود نکنید!
# ==============================

# توکن ربات از @BotFather
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی ادمین اصلی (برای پنل ادمین)
ADMIN_ID=6779342889

# آیدی یا یوزرنیم گروه (مثال: @id98a یا -100xxxxxxxxxx)
GROUP_ID=@id98a

# اگر گروه پرایویت است، آیدی عددی را بگذارید (با -100 شروع می‌شود)
# GROUP_ID=-1001234567890

# نام نمایشی گروه برای پیام‌ها
GROUP_TITLE=گروه ویژه
